{
  "name": "activity-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Personal activity ledger \u2014 static offline-first PWA (vanilla HTML/CSS/JS, no build step).",
  "scripts": {
    "test": "node tests/run.js",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:ui:build": "SMOKE_ROOT=_site node tests/ui-smoke.mjs",
    "build": "node tools/build.js",
    "serve": "python3 -m http.server 8000",
    "check:worker": "node tools/check-worker.js",
    "perf": "node tools/perf-fixture.js 3 /tmp/perf-export.xml && node --expose-gc --max-old-space-size=4096 tools/perf-parse.js /tmp/perf-export.xml"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "wrangler": "^4.42.0"
  }
}
